@{
    ViewData["Title"] = "Bestellingen";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Bestellingen</h2>
        </div>
    </div>
    <br />

    <ul class="nav nav-pills" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" data-bs-toggle="pill" href="#inprocess">
                In Verwerking
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" data-bs-toggle="pill" href="#pending">
                Openstaand
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" data-bs-toggle="pill" href="#completed">
                Afgerond
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" data-bs-toggle="pill" href="#approved">
                Goedgekeurd
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" data-bs-toggle="pill" href="#all">
                Alle
            </a>
        </li>
    </ul>

    <br /><br />

    <table id="tblData" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Naam</th>
                <th>Telefoon</th>
                <th>Email</th>
                <th>Status</th>
                <th>Totaal</th>
                <th></th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/order.js"></script>
}
