@model IEnumerable<BookStore.Models.CoverType>
@{
    ViewData["Title"] = "Kaftsoorten";
}
<div class="d-flex justify-content-between mb-3">
    <h2>Kaftsoorten</h2>
    <a class="btn btn-success" asp-action="Create">Nieuwe kaftsoort</a>
</div>
<table class="table table-striped">
    <thead>
        <tr><th>Id</th><th>Soort kaft</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach(var c in Model)
    {
        <tr>
            <td>@c.Id</td>
            <td>@c.Name</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
